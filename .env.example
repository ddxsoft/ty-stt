# ty-stt 配置示例：复制为 .env 后按需修改
TYSTT_APP_NAME=ty-stt
TYSTT_APP_VERSION=1.0.0
TYSTT_ENV=local
TYSTT_LOG_LEVEL=INFO

# Markdown 输出根目录（可直接用 Obsidian/Typora 打开）与内部数据目录
TYSTT_OUTPUT_DIR=workspace
TYSTT_DATA_DIR=data

# STT：funasr（默认）或 mock（无模型演示/测试）
TYSTT_STT_ENGINE=funasr
TYSTT_STT_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
# 本地模型目录（留空则用 ModelScope 缓存或在线下载）
TYSTT_STT_MODEL_PATH=
TYSTT_STT_DEVICE=cpu
TYSTT_STT_FP16=false
TYSTT_STT_BATCH_SIZE_S=30
TYSTT_STT_HOTWORD=
TYSTT_STT_LANGUAGE=zh
TYSTT_STT_VAD=true
TYSTT_STT_VAD_MODEL=fsmn-vad
TYSTT_STT_PUNC_MODEL=ct-punc
# VAD 合并方案：短段合并阈值(ms) / 上下文窗口(s) / 近似细对齐(默认关，时间戳更可信)
TYSTT_STT_VAD_MERGE_MS=2000
TYSTT_STT_WINDOW_SECONDS=45
TYSTT_STT_FINE_ALIGN=false

# LLM：任意 OpenAI-Compatible 服务。model=mock 可无外部依赖运行
TYSTT_LLM_BASE_URL=http://localhost:11434/v1
TYSTT_LLM_API_KEY=ollama
TYSTT_LLM_MODEL=qwen3:8b
TYSTT_LLM_TEMPERATURE=0.3

TYSTT_DEFAULT_PRESET=medium
TYSTT_MAX_CONCURRENT_TASKS=1
TYSTT_POLISH_CHUNK_CHARS=2500
TYSTT_POLISH_CONTEXT_CHARS=200

TYSTT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173